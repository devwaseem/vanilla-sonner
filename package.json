{
  "name": "vanilla-sonner",
  "version": "0.6.0",
  "main": "dist/vanilla-sonner.umd.min.js",
  "module": "dist/vanilla-sonner.es.min.mjs",
  "types": "dist/sonner.d.ts",
  "style": "dist/vanilla-sonner.min.css",
  "exports": {
    ".": {
      "types": "./dist/sonner.d.ts",
      "import": "./dist/vanilla-sonner.es.min.mjs",
      "require": "./dist/vanilla-sonner.umd.min.js",
      "default": "./dist/vanilla-sonner.es.min.mjs"
    },
    "./style.css": "./dist/vanilla-sonner.min.css"
  },
  "files": [
    "CHANGELOG.md",
    "MIGRATION.md",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test:e2e && npm run build"
  },
  "keywords": [
    "sonner-toast",
    "toast",
    "notification",
    "vanilla-js",
    "javascript",
    "ui",
    "frontend"
  ],
  "author": "Waseem Akram <waseem07799@gmail.com>",
  "license": "MIT",
  "description": "Vanilla port of Sonner Toasts",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.5.3",
    "sass": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.2"
  }
}
